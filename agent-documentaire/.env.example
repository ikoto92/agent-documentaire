# Copiez ce fichier en .env puis choisissez UNE des options ci-dessous.

# --- Option 1 : Ollama (gratuit, tout tourne sur votre ordinateur) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# --- Option 2 : Google Gemini (offre gratuite, clé sur https://aistudio.google.com/apikey) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=votre_cle_gemini
# CHAT_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001

# --- Option 3 : Groq pour le chat (quota gratuit plus large) + Gemini pour les embeddings ---
# Clé Groq sur https://console.groq.com/keys (vérifiez le nom des modèles disponibles sur leur site)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=votre_cle_groq
# CHAT_MODEL=llama-3.3-70b-versatile
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBED_API_KEY=votre_cle_gemini
# EMBED_MODEL=gemini-embedding-001

# --- Modèle de secours si le principal est surchargé (503) ou à court de quota (429) ---
# CHAT_MODEL_FALLBACK=gemini-3.8-flash-lite

# --- Recherche sur Internet (outil search_web, via DuckDuckGo, gratuit et sans clé) ---
# WEB_SEARCH=on
# WEB_MAX_RESULTS=5

# --- Réglages facultatifs ---
# DOCS_DIR=data/docs
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# TOP_K=4
