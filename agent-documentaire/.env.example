# Copiez ce fichier en .env puis choisissez UNE des options ci-dessous.

# --- Option 1 : Ollama (gratuit, tout tourne sur votre ordinateur) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# --- Option 2 : Google Gemini (offre gratuite, clé sur https://aistudio.google.com/apikey) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=votre_cle_gemini
# CHAT_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001

# --- Réglages facultatifs ---
# DOCS_DIR=data/docs
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# TOP_K=4
